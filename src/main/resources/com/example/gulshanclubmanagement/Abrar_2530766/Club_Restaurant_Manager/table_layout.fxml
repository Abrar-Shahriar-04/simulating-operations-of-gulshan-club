<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gulshanclubmanagement.Abrar_2530766.Club_Restaurant_Manager.Controller.TableLayoutController">
    <children>
        <Label layoutX="25.0" layoutY="15.0" text="Live Table Layout and Floor Status Board" />
        <TableView fx:id="tableView" layoutX="25.0" layoutY="55.0" prefHeight="310.0" prefWidth="630.0">
            <columns>
                <TableColumn fx:id="colTableName" prefWidth="200.0" text="Table" />
                <TableColumn fx:id="colGuests" prefWidth="180.0" text="Guest Count" />
                <TableColumn fx:id="colStatus" prefWidth="250.0" text="Status" />
            </columns>
        </TableView>
        <Label layoutX="25.0" layoutY="382.0" text="Guest Count:" />
        <TextField fx:id="guestCountField" layoutX="115.0" layoutY="378.0" prefWidth="90.0" />
        <Button layoutX="220.0" layoutY="378.0" mnemonicParsing="false" onAction="#toggleTableStatus" text="Toggle Status" />
        <Label fx:id="infoLabel" layoutX="340.0" layoutY="382.0" text="Selected: -" />
        <Button layoutX="25.0" layoutY="440.0" mnemonicParsing="false" onAction="#backToDashboard" text="Back" />
    </children>
</AnchorPane>
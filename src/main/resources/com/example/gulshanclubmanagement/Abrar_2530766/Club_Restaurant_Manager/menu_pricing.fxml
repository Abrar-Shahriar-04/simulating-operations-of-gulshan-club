<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gulshanclubmanagement.Abrar_2530766.Club_Restaurant_Manager.Controller.MenuPricingController">
    <children>
        <Label layoutX="25.0" layoutY="15.0" text="Daily Menu Pricing and Item Catalog Manager" />
        <Label layoutX="25.0" layoutY="55.0" text="Item Name:" />
        <TextField fx:id="itemNameField" layoutX="115.0" layoutY="51.0" />
        <Label layoutX="295.0" layoutY="55.0" text="Price:" />
        <TextField fx:id="priceField" layoutX="340.0" layoutY="51.0" prefWidth="110.0" />
        <Button layoutX="470.0" layoutY="51.0" mnemonicParsing="false" onAction="#addMenuItem" text="Add Item" />
        <Button layoutX="550.0" layoutY="51.0" mnemonicParsing="false" onAction="#deleteMenuItem" text="Delete" />
        <TableView fx:id="menuTable" layoutX="25.0" layoutY="100.0" prefHeight="330.0" prefWidth="630.0">
            <columns>
                <TableColumn fx:id="colItemName" prefWidth="280.0" text="Item Name" />
                <TableColumn fx:id="colPrice" prefWidth="170.0" text="Price" />
                <TableColumn fx:id="colStock" prefWidth="180.0" text="Stock Status" />
            </columns>
        </TableView>
        <Button layoutX="25.0" layoutY="445.0" mnemonicParsing="false" onAction="#backToDashboard" text="Back" />
    </children>
</AnchorPane>
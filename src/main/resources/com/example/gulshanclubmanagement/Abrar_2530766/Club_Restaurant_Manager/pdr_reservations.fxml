<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gulshanclubmanagement.Abrar_2530766.Club_Restaurant_Manager.Controller.PdrReservationsController">
    <children>
        <Label layoutX="25.0" layoutY="15.0" text="Private Dining Room Reservation Manager" />
        <Label layoutX="25.0" layoutY="50.0" text="Member ID:" />
        <TextField fx:id="memberIdField" layoutX="115.0" layoutY="46.0" />
        <Label layoutX="25.0" layoutY="85.0" text="Date:" />
        <TextField fx:id="dateField" layoutX="115.0" layoutY="81.0" />
        <Label layoutX="320.0" layoutY="50.0" text="Time Slot:" />
        <TextField fx:id="timeSlotField" layoutX="415.0" layoutY="46.0" />
        <Label layoutX="320.0" layoutY="85.0" text="Guest Count:" />
        <TextField fx:id="guestCountField" layoutX="415.0" layoutY="81.0" />
        <Button layoutX="25.0" layoutY="125.0" mnemonicParsing="false" onAction="#addReservation" text="Save Booking" />
        <Button layoutX="135.0" layoutY="125.0" mnemonicParsing="false" onAction="#reloadReservations" text="Load File" />
        <TableView fx:id="reservationTable" layoutX="25.0" layoutY="170.0" prefHeight="270.0" prefWidth="650.0">
            <columns>
                <TableColumn fx:id="colMemberId" prefWidth="150.0" text="Member ID" />
                <TableColumn fx:id="colDate" prefWidth="170.0" text="Date" />
                <TableColumn fx:id="colTimeSlot" prefWidth="170.0" text="Time Slot" />
                <TableColumn fx:id="colGuests" prefWidth="160.0" text="Guest Count" />
            </columns>
        </TableView>
        <Button layoutX="25.0" layoutY="455.0" mnemonicParsing="false" onAction="#backToDashboard" text="Back" />
    </children>
</AnchorPane>
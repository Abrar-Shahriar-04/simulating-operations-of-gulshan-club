<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gulshanclubmanagement.Abrar_2530766.Club_Restaurant_Manager.Controller.MenuStockController">
    <children>
        <Label layoutX="25.0" layoutY="15.0" text="Daily Menu Stock and Inventory Toggle" />
        <TableView fx:id="stockTable" layoutX="25.0" layoutY="55.0" prefHeight="310.0" prefWidth="630.0">
            <columns>
                <TableColumn fx:id="colItemName" prefWidth="280.0" text="Item Name" />
                <TableColumn fx:id="colPrice" prefWidth="150.0" text="Price" />
                <TableColumn fx:id="colStockStatus" prefWidth="200.0" text="Stock Status" />
            </columns>
        </TableView>
        <Label layoutX="25.0" layoutY="385.0" text="Status:" />
        <ChoiceBox fx:id="stockChoiceBox" layoutX="80.0" layoutY="381.0" prefWidth="220.0" />
        <Button layoutX="320.0" layoutY="381.0" mnemonicParsing="false" onAction="#updateStockStatus" text="Update Status" />
        <Button layoutX="25.0" layoutY="440.0" mnemonicParsing="false" onAction="#backToDashboard" text="Back" />
    </children>
</AnchorPane>
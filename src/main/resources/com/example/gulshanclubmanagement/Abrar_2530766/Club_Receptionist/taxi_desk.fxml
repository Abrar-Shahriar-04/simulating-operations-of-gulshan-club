<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gulshanclubmanagement.Abrar_2530766.Club_Receptionist.Controller.TaxiDeskController">
    <children>
        <Label layoutX="25.0" layoutY="15.0" text="Transportation and Taxi Coordination Desk" />
        <Label layoutX="25.0" layoutY="50.0" text="Member ID:" />
        <TextField fx:id="memberIdField" layoutX="120.0" layoutY="46.0" />
        <Label layoutX="25.0" layoutY="85.0" text="Destination:" />
        <TextField fx:id="destinationField" layoutX="120.0" layoutY="81.0" />
        <Label layoutX="320.0" layoutY="50.0" text="Preferred Time:" />
        <TextField fx:id="timeField" layoutX="425.0" layoutY="46.0" />
        <Label layoutX="320.0" layoutY="85.0" text="Cab Service:" />
        <TextField fx:id="cabServiceField" layoutX="425.0" layoutY="81.0" />
        <Button layoutX="25.0" layoutY="125.0" mnemonicParsing="false" onAction="#addTaxiRequest" text="Add Request" />
        <Button layoutX="130.0" layoutY="125.0" mnemonicParsing="false" onAction="#completeRide" text="Complete Ride" />
        <Button layoutX="240.0" layoutY="125.0" mnemonicParsing="false" onAction="#cancelRide" text="Cancel Ride" />
        <TableView fx:id="taxiTable" layoutX="25.0" layoutY="170.0" prefHeight="270.0" prefWidth="650.0">
            <columns>
                <TableColumn fx:id="colMemberId" prefWidth="110.0" text="Member ID" />
                <TableColumn fx:id="colDestination" prefWidth="160.0" text="Destination" />
                <TableColumn fx:id="colTime" prefWidth="120.0" text="Preferred Time" />
                <TableColumn fx:id="colCabService" prefWidth="140.0" text="Cab Service" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>
        <Button layoutX="25.0" layoutY="455.0" mnemonicParsing="false" onAction="#backToDashboard" text="Back" />
    </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="480.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gulshanclubmanagement.Abrar_2530766.Club_Receptionist.Controller.PhoneDirectoryController">
    <children>
        <Label layoutX="25.0" layoutY="15.0" text="Internal Department Phone Directory" />
        <TextField fx:id="searchDeptField" layoutX="25.0" layoutY="50.0" prefWidth="220.0" promptText="Search Department" />
        <Button layoutX="260.0" layoutY="50.0" mnemonicParsing="false" onAction="#searchDepartment" text="Search" />
        <Button layoutX="325.0" layoutY="50.0" mnemonicParsing="false" onAction="#showAllDepartments" text="Show All" />
        <TableView fx:id="directoryTable" layoutX="25.0" layoutY="95.0" prefHeight="320.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colDepartment" prefWidth="220.0" text="Department" />
                <TableColumn fx:id="colExtension" prefWidth="180.0" text="Extension No" />
                <TableColumn fx:id="colHotline" prefWidth="200.0" text="Emergency Hotline" />
            </columns>
        </TableView>
        <Button layoutX="25.0" layoutY="430.0" mnemonicParsing="false" onAction="#backToDashboard" text="Back" />
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gulshanclubmanagement.Abrar_2530766.Club_Receptionist.Controller.VisitorPassController">
    <children>
        <Label layoutX="25.0" layoutY="15.0" text="Walk-In Visitor Pass Management" />
        <Label layoutX="25.0" layoutY="50.0" text="Visitor Name:" />
        <TextField fx:id="visitorNameField" layoutX="120.0" layoutY="46.0" />
        <Label layoutX="25.0" layoutY="85.0" text="Phone:" />
        <TextField fx:id="phoneField" layoutX="120.0" layoutY="81.0" />
        <Label layoutX="320.0" layoutY="50.0" text="Host Member:" />
        <TextField fx:id="hostMemberField" layoutX="420.0" layoutY="46.0" />
        <Label layoutX="320.0" layoutY="85.0" text="Purpose:" />
        <TextField fx:id="purposeField" layoutX="420.0" layoutY="81.0" />
        <Button layoutX="25.0" layoutY="125.0" mnemonicParsing="false" onAction="#generatePass" text="Generate Pass" />
        <Button layoutX="140.0" layoutY="125.0" mnemonicParsing="false" onAction="#checkOutVisitor" text="Check Out Visitor" />
        <Label fx:id="passIdLabel" layoutX="280.0" layoutY="129.0" text="Pass ID: -" />
        <TableView fx:id="visitorTable" layoutX="25.0" layoutY="170.0" prefHeight="270.0" prefWidth="650.0">
            <columns>
                <TableColumn fx:id="colPassId" prefWidth="90.0" text="Pass ID" />
                <TableColumn fx:id="colName" prefWidth="130.0" text="Name" />
                <TableColumn fx:id="colPhone" prefWidth="110.0" text="Phone" />
                <TableColumn fx:id="colHost" prefWidth="120.0" text="Host Member" />
                <TableColumn fx:id="colPurpose" prefWidth="110.0" text="Purpose" />
                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
            </columns>
        </TableView>
        <Button layoutX="25.0" layoutY="455.0" mnemonicParsing="false" onAction="#backToDashboard" text="Back" />
    </children>
</AnchorPane>